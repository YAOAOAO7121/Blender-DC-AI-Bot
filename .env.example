# 範本：複製成 .env 後填入自己的值（.env 不要上傳到任何地方）
DISCORD_TOKEN=
GEMINI_API_KEY=
ASK_CHANNEL_ID=

# ── 選填（沒寫就用預設值）──
MODEL=gemini-3.8-flash
LOCAL_MODEL=qwen3:4b-instruct
USE_LOCAL=1
WEB_SEARCH=1
AUTO_SAVE_WEB=1
SHOW_SOURCES=1
KB_MIN_SCORE=4.0

# 問題的關鍵字在找到的資料裡出現的比例（0~1），低於這個值就當作知識庫沒這題、改上網查
KB_MIN_COVERAGE=0.15
# 1 = 用本地模型回答前，先讓它判斷資料夠不夠回答
LOCAL_JUDGE=1

# Gemini 忙線（503）時最多試幾次（每次間隔 2、6、18 秒…）
GEMINI_RETRIES=3

# 1 = 用小樽老師的語氣（設定在 persona/ 資料夾）；0 = 一般助教口吻
PERSONA=1
# 1 = 簡短的回答拆成幾則短訊息，像小樽在 Discord 連發
SPLIT_SHORT=1
# 選填：主模型一直忙線（503）時改用的備用 Gemini 模型，例如比較輕量的 flash-lite 版本；不填就不換
GEMINI_FALLBACK_MODEL=
# 1 = 看學生傳的 Blender 截圖（用 Gemini 看圖，圖片會傳給 Google）
VISION=1
# 1 = 回答下方附延伸教學連結（官方手冊＋YouTube 教學影片）
TUTORIAL_LINKS=1
# 本地模型只看「分數 ≥ 最高分 × 這個比例」的資料段落（越高越只看最相關的那段，小模型比較不會抓錯）
LOCAL_KEEP_RATIO=0.7
# 延伸教學最多幾個連結
TUTORIAL_MAX=2

# ── 👍/👎 回饋（v13）──
# 1 = 回答下方加 👍/👎，學生按了記到 feedback_log.csv；按 👎 會通知審核頻道
FEEDBACK=1

# ── 老師審核頻道（v13）──
# 老師專用頻道的 ID（Discord 開發者模式 → 對頻道按右鍵 → 複製頻道 ID）
# 有填：網路整理的筆記一律先貼到這裡，老師按 ✅ 才加進知識庫（AUTO_SAVE_WEB 會被忽略）
# 沒填：照 AUTO_SAVE_WEB 的設定
REVIEW_CHANNEL_ID=
# 誰可以按 ✅/❌ 審核（使用者 ID，多個用逗號分隔）；空白 = 看得到審核頻道的人都可以
REVIEWER_IDS=

# ── 作業健檢（v13）──
# 1 = 學生丟 .blend 檔就自動檢查常見問題
BLEND_CHECK=1
# Blender 執行檔的位置；不填會自動找 C:\Program Files\Blender Foundation\ 裡最新的版本
BLENDER_PATH=
# 檢查一個檔案最多幾秒、檔案最大幾 MB
BLEND_TIMEOUT=180
BLEND_MAX_MB=100
